# =========================================================
# TimePro - Variables de entorno
# Copia este archivo a `.env` y completa los valores.
# En Railway: crea estas variables en el panel de Variables.
# =========================================================

# ---- Base de datos (PostgreSQL de Railway) -----------------
# Railway la inyecta automáticamente como DATABASE_URL al añadir
# una base de datos PostgreSQL. Convierte la URL si es necesario:
# DATABASE_URL="postgresql://user:pass@host:port/db?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/timaprodb?sslmode=require"

# ---- Seguridad / Sesión -------------------------------------
# Genera con: openssl rand -base64 32
AUTH_SECRET="cambia-esta-clave-por-una-secreta-y-larga"

# ---- URL pública del sistema --------------------------------
NEXT_PUBLIC_APP_URL="https://timepro-production.up.railway.app"

# ---- Correo (Resend) ----------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="TimePro <no-responder@tu-dominio.com>"

# ---- WhatsApp (Meta Cloud API) ------------------------------
WHATSAPP_TOKEN="EAAGxxxxxxxxx"
WHATSAPP_PHONE_NUMBER_ID="123456789012345"
WHATSAPP_VERIFY_TOKEN="timepro_verify_123"

# ---- Pagos ---------------------------------------------------
# Si usas Stripe (opcional). Dejado vacío = cobro manual
# (referencia + transferencia / depósito, activación manual o por webhook).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_BASIC_MONTHLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_ENTERPRISE_MONTHLY=""

# ---- Webhook general del sistema -----------------------------
# Token que protege tu webhook general /api/webhook
GENERAL_WEBHOOK_TOKEN="timepro_webhook_123"

# ---- Almacenamiento de archivos ------------------------------
# driver: "base64" (gratis, en la base de datos, recomendado para empezar)
#         o "s3" (Cloudflare R2 / AWS S3, para escalar)
STORAGE_DRIVER="base64"
S3_BUCKET=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
S3_PUBLIC_URL=""

# ---- Prueba gratis -------------------------------------------
TRIAL_DAYS="14"

# ---- Datos de la empresa dueña del SaaS ----------------------
OWNER_NAME="Total App GT"
OWNER_PHONE="58303182"
OWNER_EMAIL="totalappgt@gmail.com"
NEXT_PUBLIC_OWNER_WHATSAPP="50258303182"
